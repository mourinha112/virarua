# Seu Mundo Novo — variáveis de ambiente (copie para .env e preencha; NUNCA commite valores reais)

# ---------- núcleo ----------
SMN_AMBIENTE=dev                       # dev | teste | producao
PORT=8787
DATABASE_URL=postgres://smn@127.0.0.1:54329/smn_dev
SMN_URL_PUBLICA=http://localhost:5173
SMN_SEGREDO=                           # obrigatório em produção (string longa aleatória)
SMN_CHAVE_CRIPTO=                      # 64 hex (32 bytes) para AES-256-GCM dos tokens em repouso

# ---------- Instagram (Instagram API with Instagram Login) — ver docs/meta-instagram.md ----------
IG_ADAPTADOR=dev                       # dev = nunca chama a rede | oficial = Graph API
IG_APP_SECRET=                         # valida X-Hub-Signature-256 dos webhooks
IG_VERIFY_TOKEN=                       # handshake do webhook
IG_CONTA_ID=                           # id da conta profissional oficial
IG_TOKEN=                              # só bootstrap; o servidor guarda cifrado em instagram_connections
IG_GRAPH_VERSAO=v26.0
IG_PAYLOAD_MAX=262144

# ---------- reivindicação, ruas, presença ----------
CLAIM_LINK_MIN=30
CLAIM_DESAFIO_MIN=20
RESERVA_DIAS=30
RUA_CAPACIDADE=24
PRESENCA_SEG=90
ADMIN_SESSAO_MIN=120

# ---------- kill switches (separados) ----------
KILL_EVENTOS=0
KILL_RENDER=0
KILL_PUBLICACAO=1                      # publicação externa desligada por padrão

# ---------- conteúdo / publicação (dry-run por padrão) ----------
AUTOPUBLISH=0
PUBLICACAO_OFICIAL=nao                 # só "sim" depois de revisão e testes com a conta oficial
POSTS_DIA=1
POSTS_PATROCINADOS_DIA=1
POST_HORA=19
POST_INTERVALO_MIN=360
PUBLICACAO_TENTATIVAS=3
FATO_VALIDADE_H=24
PAUTA_RODIZIO_H=48
CONTEUDO_URL_MIDIA=                    # URL pública HTTPS onde os MP4 ficam acessíveis à Meta
CONTEUDO_TOKEN_ESTUDIO=                # Bearer do estúdio para /interno/conteudo/*
CONTEUDO_DIR_RENDERS=video-studio/out/renders
CONTEUDO_DIR_PACOTES=video-studio/out/pacotes
CONTEUDO_DIR_CAPTURAS=video-studio/assets/capturas

# ---------- estúdio de vídeo (video-studio/) ----------
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
FFMPEG=ffmpeg
FFPROBE=ffprobe
RENDER_MAX_SIMULTANEOS=1
RENDER_LEASE_MIN=15
STUDIO_RENDER_TIMEOUT_S=300
STUDIO_CARGA_MAX=0.85
STUDIO_MEM_LIVRE_MIN_MB=1024

# ---------- IA opcional (sem chave = modo determinístico) ----------
IA_PROVEDOR=                           # anthropic | openai_compat
IA_CHAVE=
IA_MODELO=
IA_URL=
IA_TIMEOUT_MS=15000
